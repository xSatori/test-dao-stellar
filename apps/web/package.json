{
  "name": "@stellar-dao/web",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "node ../../scripts/generate-deployment-config.mjs && panda codegen && panda cssgen",
    "dev": "next dev",
    "prebuild": "pnpm --filter @stellar-dao/token-bindings --filter @stellar-dao/governor-bindings --filter @stellar-dao/treasury-bindings --filter @stellar-dao/auction-bindings build && node ../../scripts/generate-deployment-config.mjs && panda codegen && panda cssgen",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "panda:codegen": "panda codegen && panda cssgen"
  },
  "dependencies": {
    "@creit.tech/stellar-wallets-kit": "^2.5.0",
    "@neondatabase/serverless": "^1.1.0",
    "@noble/hashes": "^2.2.0",
    "@stellar-dao/governor-bindings": "workspace:*",
    "@stellar-dao/auction-bindings": "workspace:*",
    "@stellar-dao/token-bindings": "workspace:*",
    "@stellar-dao/treasury-bindings": "workspace:*",
    "@stellar/stellar-sdk": "^17.0.1",
    "buffer": "^6.0.3",
    "next": "^15.4.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "swr": "^2.5.0",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@ark-ui/react": "^5.37.2",
    "@pandacss/dev": "1.11.5",
    "@pandacss/preset-panda": "1.11.5",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.0",
    "lucide-react": "^1.27.0",
    "typescript": "^5.8.0"
  }
}
